# syntax=docker/dockerfile:1
# Video role — security detector + frame server (port 8765).
# Owns the webcam and runs RF-DETR / InsightFace on CUDA.

FROM nvidia/cuda:12.5.1-runtime-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 \
    python3-pip \
    python3.12-venv \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgtk-3-0 \
    libcanberra-gtk3-0 \
    ffmpeg \
    v4l-utils \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/security

COPY security/requirements.txt ./
RUN pip3 install --break-system-packages --no-cache-dir -r requirements.txt

COPY security/ ./
COPY docker/entrypoint-video.sh /app/

ENV WARDEN_URL=http://127.0.0.1:3200 \
    OLLAMA_URL=http://127.0.0.1:11434 \
    FRAME_SERVER_HOST=0.0.0.0 \
    FRAME_SERVER_PORT=8765 \
    PYTHONUNBUFFERED=1

EXPOSE 8765

ENTRYPOINT ["/app/entrypoint-video.sh"]
CMD ["python3", "main.py", "--config", "/app/security/config/settings.yaml"]
